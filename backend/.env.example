# ─────────────────────────────────────────────────────────────────────────────
# spot_5 — copy to backend/.env and fill in. Nothing else is host-specific,
# so moving to another machine is: copy this file, start the process.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Nothing to configure. A SQLite file is created at backend/var/spot5.db on the
# first run: no server, no network, no credentials, nothing to install.
#
# DB_PATH=                  # put the database file somewhere else
# DB_BUSY_TIMEOUT_MS=10000  # how long a write waits for a concurrent one
# DB_CONNECT_RETRIES=5

# ── Mode and market ──────────────────────────────────────────────────────────
TRADING_MODE=PAPER          # PAPER (simulated money) | REAL (your funds)
SYMBOL=BTC/USDT
BASE_CURRENCY=BTC
QUOTE_CURRENCY=USDT
PAPER_STARTING_CASH=10000
CYCLE_SECONDS=900           # one decision per 15-minute candle
AUTOTRADE=1                 # 0 = decide and record, never place an order
AUTOSTART_SCHEDULER=1
INSTANCE_ID=                # optional label, shows up in the audit trail

# ── Hard caps (an admin rule may tighten these, never loosen them) ───────────
MAX_POSITION_PCT=25         # most of equity one position may hold
MAX_CAPITAL_AT_RISK_PCT=2   # most of equity one trade may lose at its stop
MAX_TRADES_PER_DAY=12
MAX_DAILY_LOSS_PCT=4
MAX_OPEN_POSITIONS=1
MIN_CONFIDENCE=0.55
MIN_ORDER_QUOTE=10
DEFAULT_STOP_LOSS_PCT=1.5
DEFAULT_TAKE_PROFIT_PCT=3.0

# ── The Agent's brain ────────────────────────────────────────────────────────
LLM_ENABLED=1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b,openai/gpt-oss-20b,llama-3.1-8b-instant
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# ── Knowledge base (hot reload, no downtime) ─────────────────────────────────
# KB_PATH=backend/llm_agent/trading_theories_knowledge_base.md
KB_REFRESH_SECONDS=60       # 0 = check on every decision
KB_MAX_PROMPT_CHARS=9000
KB_MAX_PROMPT_SECTIONS=7
KB_PERSIST_TO_DB=1          # every good version is stored, so a new host can load it

# ── Engines ──────────────────────────────────────────────────────────────────
ENGINE_1_ENABLED=1
ENGINE_1_PAIR=XBTUSDT       # Kraken naming
ENGINE_1_PRIMARY_HORIZON=4h
ENGINE_1_USE_NEWS=1
ENGINE_1_USE_LLM=0          # engine_1's own LLM pass; the Agent is the voice, so off
ENGINE_1_OFFLINE=0          # 1 = synthetic data, for testing without a network
ENGINE_1_TIMEOUT_S=180
ALPHA_VANTAGE_API_KEY=      # free key from alphavantage.co

ENGINE_2_ENABLED=1
ENGINE_2_SOURCE=auto        # auto | inline (needs TensorFlow) | file
ENGINE_2_MODELS_DIR=backend/engine_2/models
# ENGINE_2_DECISION_LOG=backend/engine_2/reports/live_decisions.jsonl
ENGINE_2_TIMEOUT_S=120

# engine_2 training. The pipeline is a MODEL FACTORY: it pulls market data and
# writes model files. It never places an order and never needs a key that could.
# BINANCE_API_KEY is optional and buys nothing but a higher rate limit; it must be
# READ-ONLY (no trading, no withdrawals) — engine_2/fetch.py refuses to run with a
# trading-capable key.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
ENGINE_2_SYMBOL=BTC/USDT        # documented BTC-only policy; see engine_2/README.md
ENGINE_2_TIMEFRAME=15m
ENGINE_2_HISTORY_YEARS=3
ENGINE_2_AUTO_TRAIN=0           # 1 = retrain on a schedule inside this process
ENGINE_2_TRAIN_INTERVAL_S=604800    # weekly, when AUTO_TRAIN=1
ENGINE_2_DRIFT_INTERVAL_S=3600      # how often live decay is scored
ENGINE_2_RETRAIN_ON_DRIFT=0     # 1 = a sustained decay triggers a retrain
ENGINE_2_EPOCHS=60
ENGINE_2_PPO_UPDATES=200
ENGINE_2_MODEL_RETENTION=5      # versioned bundles kept on disk for rollback
# hard gates: the cycle raises and promotes nothing when these are not met
ENGINE_2_GATE_MIN_DIR_ACC=0.51
ENGINE_2_GATE_MIN_PRED_STD=0.02
ENGINE_2_GATE_MIN_POLICY_SPREAD=0.05
# live decay: flag a retrain after this many consecutive failing checks
ENGINE_2_DRIFT_MIN_DIR_ACC=0.51
ENGINE_2_DRIFT_BREACHES=3

ENGINE_3_ENABLED=1
ENGINE_3_MIN_SAMPLES=40         # refuses to train on less
ENGINE_3_MODEL_RETENTION=10     # versions kept after each evaluation
ENGINE_3_TRAIN_INTERVAL_S=21600 # auto-train every 6 hours

# ── API ──────────────────────────────────────────────────────────────────────
PORT=8000
API_HOST=0.0.0.0
ADMIN_TOKEN=                # required in REAL mode; sent as X-Admin-Token
LOG_LEVEL=INFO

# ── REAL mode only ───────────────────────────────────────────────────────────
LIVE_TRADING_CONFIRMED=0    # 1 is the explicit "yes, real money" acknowledgement
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
FEE_RATE=0.00075
SLIPPAGE_PCT=0.0005